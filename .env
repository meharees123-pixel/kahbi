# Database
MONGODB_URI=your_mongodb_connection_string

# Application
NODE_ENV=production
PORT=3000

# Redis
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=your_jwt_secret

# Frontend URL
CLIENT_ORIGIN=https://your-domain.com

# Business Settings
CURRENCY=QAR
DEFAULT_SERVICE_RADIUS_KM=20
RESTAURANT_ACCEPTANCE_SLA_MINUTES=5
CUSTOMER_CANCELLATION_WINDOW_MINUTES=5
DEFAULT_DELIVERY_FEE=0
CUSTOMER_ADMIN_FEE=0
RESTAURANT_COMMISSION_PERCENT=12

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id

# OTP
CUSTOMER_OTP_ENABLED=true
RECOVERY_OTP_TTL_MINUTES=5

# WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_WABA_ID=your_waba_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_PHONE_NUMBER=your_business_phone
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_POPUP_ENABLED=true

# Gemini AI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key

# Notifications
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password

# Email
EMAIL_FROM=your_email@example.com
EMAIL_FROM_NAME=KABHI

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
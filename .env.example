PORT=3000
# Template default only. The ignored root .env is used at runtime; replace this
# with your private Atlas URI there when you want the API and seeder to use Atlas.
MONGODB_URI=mongodb://mongodb:27017/kabhi
JWT_SECRET=replace-this-with-a-long-random-value
CLIENT_ORIGIN=http://localhost:4200
CURRENCY=QAR
DEFAULT_SERVICE_RADIUS_KM=20
RESTAURANT_ACCEPTANCE_SLA_MINUTES=5
CUSTOMER_CANCELLATION_WINDOW_MINUTES=5
DEFAULT_DELIVERY_FEE=0
CUSTOMER_ADMIN_FEE=0
RESTAURANT_COMMISSION_PERCENT=12
FIREBASE_PROJECT_ID=kabhiofficial
RECOVERY_OTP_TTL_MINUTES=5

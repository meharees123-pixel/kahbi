{
  "name": "kahbi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --prefix server",
    "dev:web": "npm run start --prefix client",
    "local": "docker compose up --build",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "test": "npm test --prefix server",
    "install:all": "npm install && cd server && npm install --no-save && cd .. && cd client && npm install --no-save"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
